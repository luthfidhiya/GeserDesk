{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeserDesk",
  "version": "0.1.0",
  "identifier": "dev.geserdesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release -p geserdesk-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeserDesk",
        "width": 980,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Share one keyboard and mouse between computers",
    "longDescription": "GeserDesk moves the cursor, keyboard and clipboard from one computer to the others on the network, by pushing the cursor past the edge of the screen.",
    "license": "GPL-3.0-or-later",
    "publisher": "GeserDesk contributors",
    "linux": {
      "deb": {
        "depends": [
          "libxdo3",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/bin/geserdesk": "../../../target/release/geserdesk"
        }
      }
    }
  }
}
